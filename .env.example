# Copy to .env and adjust. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Runtime connection: use a NON-superuser role so Postgres row-level security applies.
DATABASE_URL=postgres://cadence_app:cadence_app@localhost:5432/cadence
# Migrations run as the table owner.
MIGRATE_DATABASE_URL=postgres://cadence:cadence@localhost:5432/cadence
PORTAL_BASE_URL=http://localhost:8000
# Local time (DJANGO_TIME_ZONE, default America/New_York) the scheduler runs generate_pm and import_openfda each day.
SCHEDULER_DAILY_AT=02:30
# Links in invitation and password-reset emails start with this (the address people use to reach the app).
APP_BASE_URL=http://localhost:8000
# Email: with DJANGO_DEBUG=1 emails are printed to the console; otherwise they go through SMTP.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Cadence CE <no-reply@localhost>
